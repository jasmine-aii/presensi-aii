# Supabase — copy this file to `.env` and fill in from your project's
# Settings → API page. Expo inlines any var prefixed EXPO_PUBLIC_ at build time.
# The anon key is safe to ship in a client app; row-level security protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
