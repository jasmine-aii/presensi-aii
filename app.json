{
  "expo": {
    "name": "Presensi Anugerah",
    "slug": "presensi-aii",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "presensi-aii",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.anugerah.absensi"
    },
    "android": {
      "package": "id.anugerah.absensi",
      "adaptiveIcon": {
        "backgroundColor": "#16215E"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
