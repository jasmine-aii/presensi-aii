{
  "expo": {
    "name": "Presenta",
    "slug": "presensi-aii",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "presensi-aii",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.anugerah.absensi"
    },
    "android": {
      "package": "id.anugerah.absensi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16215E"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan Presenta mengakses kamera untuk foto selfie bukti absensi."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan Presenta membaca lokasi untuk verifikasi radius kantor (geofence)."
        }
      ]
    ]
  }
}
